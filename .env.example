# Copy this file to .env and fill in your values
# Never commit the actual .env file

# ── Google Gemini API Keys ─────────────────────────────────────────
# Get your keys at: https://aistudio.google.com/app/apikey
GEMINI_TEXT_API_KEY=your_gemini_api_key_here
GEMINI_IMAGE_API_KEY=your_gemini_api_key_here

# ── Flask Secret Key ───────────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_long_random_secret_key_here

# ── Admin Credentials ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ── Email Notifications (optional) ────────────────────────────────
# Leave blank to disable email features
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your_gmail_app_password
